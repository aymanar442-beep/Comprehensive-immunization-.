{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Cloud note and task records persisted in Firestore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Detailed description or notes",
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "description": "Category or tag",
          "enum": ["work", "personal", "general", "urgent"],
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "description": "Completion status",
          "enum": ["todo", "in_progress", "completed"]
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last update"
        }
      },
      "required": ["title", "userId", "status", "category", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile collection"
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/TaskItem"
      },
      "description": "Realtime task notes collection"
    }
  }
}
